<Window x:Class="BlobStorageDriver.TrayApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BlobStorageDriver.TrayApp.ViewModels"
        mc:Ignorable="d"
        Title="Blob Storage Driver" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Navigation Panel -->
        <Border Grid.Column="0" Background="White">
            <DockPanel>
                <!-- App Header -->
                <StackPanel DockPanel.Dock="Top" Margin="16">
                    <TextBlock Text="☁" FontSize="32" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Blob Storage" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="Driver" FontSize="14" 
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                
                <!-- Navigation Items -->
                <StackPanel>
                    <RadioButton x:Name="NavStatus" IsChecked="True" Style="{StaticResource NavItemStyle}" 
                                 Content="📊 Status" Checked="NavItem_Checked"/>
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavItemStyle}" 
                                 Content="📋 Activity" Checked="NavItem_Checked"/>
                    <RadioButton x:Name="NavConflicts" Style="{StaticResource NavItemStyle}" 
                                 Content="⚠ Conflicts" Checked="NavItem_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItemStyle}" 
                                 Content="⚙ Settings" Checked="NavItem_Checked"/>
                </StackPanel>
                
                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16" VerticalAlignment="Bottom">
                    <Button Content="Open Sync Folder" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenSyncFolderCommand}" Margin="0,4"/>
                    <Button Content="Sync Now" Style="{StaticResource ModernButton}"
                            Command="{Binding SyncNowCommand}" Margin="0,4"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Border Grid.Column="1" Margin="16">
            <Grid>
                <!-- Status Page -->
                <Grid x:Name="StatusPage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Status Card -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Status Icon -->
                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" 
                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,16,0">
                                <TextBlock Text="☁" FontSize="32" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <!-- Status Text -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                    <Run Text="Last synced:"/>
                                    <Run Text="{Binding LastSyncTime, StringFormat='{}{0:g}'}"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- Pause Button -->
                            <Button Grid.Column="2" Command="{Binding PauseSyncCommand}"
                                    Style="{StaticResource SecondaryButton}">
                                <TextBlock>
                                    <Run Text="{Binding IsPaused, Converter={StaticResource BoolToText}, 
                                         ConverterParameter='Resume|Pause'}"/>
                                    <Run Text=" Sync"/>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Progress Bar -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SyncState, Converter={StaticResource SyncingToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding CurrentFile}" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100"
                                         Style="{StaticResource ModernProgressBar}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Stats Grid -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Pending -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PendingCount}" FontSize="36" FontWeight="Light"
                                           Foreground="{StaticResource PrimaryBrush}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Pending" FontSize="14" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Conflicts -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ConflictCount}" FontSize="36" FontWeight="Light"
                                           Foreground="{StaticResource WarningBrush}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Conflicts" FontSize="14" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Errors -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ErrorCount}" FontSize="36" FontWeight="Light"
                                           Foreground="{StaticResource ErrorBrush}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Errors" FontSize="14" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                
                <!-- Activity Page -->
                <Grid x:Name="ActivityPage" Visibility="Collapsed">
                    <Border Style="{StaticResource CardBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Recent Activity" 
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                            
                            <ListView ItemsSource="{Binding RecentActivity}" BorderThickness="0"
                                      Background="Transparent">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" 
                                                       FontSize="16" Margin="0,0,12,0" 
                                                       VerticalAlignment="Center"/>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FileName}" FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Status}" 
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"/>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
                
                <!-- Conflicts Page -->
                <Grid x:Name="ConflictsPage" Visibility="Collapsed">
                    <Border Style="{StaticResource CardBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Sync Conflicts" 
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                            
                            <TextBlock DockPanel.Dock="Top" 
                                       Visibility="{Binding Conflicts.Count, Converter={StaticResource ZeroToVis}}"
                                       Text="No conflicts to resolve" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,32"/>
                            
                            <ListView ItemsSource="{Binding Conflicts}" BorderThickness="0"
                                      SelectedItem="{Binding SelectedConflict}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,0,0,1"
                                                Padding="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="14"/>
                                                    <TextBlock Text="{Binding FilePath}" 
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="12" Margin="0,4,0,0">
                                                        <Run Text="Detected:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <Run Text="{Binding DetectedAt, StringFormat='{}{0:g}'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Keep Local" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.KeepLocalCommand, 
                                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            Margin="4,0"/>
                                                    <Button Content="Keep Cloud" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.KeepCloudCommand, 
                                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            Margin="4,0"/>
                                                    <Button Content="Keep Both" Style="{StaticResource ModernButton}"
                                                            Command="{Binding DataContext.KeepBothCommand, 
                                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            Margin="4,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
                
                <!-- Settings Page -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,0">
                            <!-- Azure Connection -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Azure Blob Storage" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                    
                                    <!-- Storage Account and Container -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Storage Account Name" Margin="0,0,0,4"/>
                                            <TextBox x:Name="AccountNameTextBox" Style="{StaticResource ModernTextBox}" 
                                                     Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="e.g., mystorageaccount"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Container Name" Margin="0,0,0,4"/>
                                            <TextBox x:Name="ContainerNameTextBox" Style="{StaticResource ModernTextBox}" 
                                                     Text="{Binding ContainerName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="e.g., mycontainer"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Authentication Type -->
                                    <TextBlock Text="Authentication Method" Margin="0,8,0,4"/>
                                    <ComboBox x:Name="AuthTypeCombo" 
                                              Margin="0,0,0,12"
                                              Padding="8"
                                              FontSize="14"/>
                                    
                                    <!-- Connection String (conditional) -->
                                    <StackPanel x:Name="ConnectionStringPanel" Visibility="Collapsed">
                                        <TextBlock Text="Connection String" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource ModernTextBox}" 
                                                 Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Full Azure Storage connection string"/>
                                    </StackPanel>
                                    
                                    <!-- Account Key (conditional) -->
                                    <StackPanel x:Name="AccountKeyPanel" Visibility="Collapsed">
                                        <TextBlock Text="Account Key" Margin="0,0,0,4"/>
                                        <PasswordBox x:Name="AccountKeyBox" Style="{StaticResource ModernPasswordBox}"
                                                     ToolTip="Storage account access key"/>
                                    </StackPanel>
                                    
                                    <!-- SAS Token (conditional) -->
                                    <StackPanel x:Name="SasTokenPanel" Visibility="Collapsed">
                                        <TextBlock Text="SAS Token" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource ModernTextBox}" 
                                                 Text="{Binding SasToken, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" MaxHeight="60"
                                                 ToolTip="Shared Access Signature token (starts with ?sv=)"/>
                                    </StackPanel>
                                    
                                    <!-- Entra ID Sign In Button (conditional) -->
                                    <StackPanel x:Name="EntraIdPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Border Background="#E3F2FD" BorderBrush="#64B5F6" BorderThickness="1" 
                                                CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="🔐 Microsoft Entra ID Authentication" FontWeight="SemiBold" 
                                                           Foreground="#1565C0" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#0D47A1" FontSize="12">
                                                    Sign in with your Microsoft account. Your account needs 'Storage Blob Data Contributor' role on the storage account.
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tenant ID (optional)" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TenantIdBox" Style="{StaticResource ModernTextBox}" 
                                                         Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Azure AD Tenant ID (leave blank for auto-detect)"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="&#160;" Margin="0,0,0,4"/>
                                                <Button x:Name="SignInButton" Content="🔑 Sign In with Microsoft" 
                                                        Style="{StaticResource ModernButton}"
                                                        Click="SignInButton_Click"
                                                        Padding="16,10"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <TextBlock x:Name="SignInStatus" Margin="0,8,0,0" FontSize="12" Foreground="Green" 
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                    
                                    <!-- Test Connection button -->
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button x:Name="TestConnectionButton" Content="Test Connection" 
                                                Style="{StaticResource SecondaryButton}"
                                                Click="TestConnectionButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Sync Settings -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Sync Settings" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Local Sync Folder" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" 
                                                     Text="{Binding LocalSyncFolder}"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="1" Content="Browse..." 
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding BrowseSyncFolderCommand}"
                                                VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Max Cache Size (MB)" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" 
                                                     Text="{Binding MaxCacheSizeMB}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Sync Interval (minutes)" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" 
                                                     Text="{Binding SyncIntervalMinutes}"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <CheckBox Content="Enable real-time sync" Margin="0,12,0,0"
                                              IsChecked="{Binding EnableRealTimeSync}"/>
                                    <CheckBox Content="Pause on metered connection" Margin="0,8,0,0"
                                              IsChecked="{Binding PauseOnMeteredConnection}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- UI Settings -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Windows Integration" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                    
                                    <TextBlock Text="Integration Mode" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding IntegrationModeOptions}" 
                                              SelectedItem="{Binding SelectedIntegrationMode}"
                                              Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource IntegrationModeToDisplayName}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    
                                    <!-- Mode Descriptions -->
                                    <Border Background="#E3F2FD" BorderBrush="#64B5F6" BorderThickness="1" 
                                            CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="ℹ️ Integration Mode Info" FontWeight="SemiBold" 
                                                       Foreground="#1565C0" Margin="0,0,0,4"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="#0D47A1" FontSize="12">
                                                <Run FontWeight="SemiBold">Local Folder:</Run> Syncs files to a folder using Windows Cloud Files API (placeholder files).
                                                <LineBreak/>
                                                <Run FontWeight="SemiBold">Navigation Pane:</Run> Appears in File Explorer's sidebar for easy access.
                                                <LineBreak/>
                                                <Run FontWeight="SemiBold">Drive Letter:</Run> Mounts as a drive (e.g., Z:) for legacy SMB compatibility. Requires Dokan driver.
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Drive Letter options (shown only for VirtualDrive mode) -->
                                    <StackPanel Visibility="{Binding ShowDriveLetterField, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Width="100">
                                                <TextBlock Text="Drive Letter" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AvailableDriveLetters}" 
                                                          SelectedItem="{Binding SelectedDriveLetter}"
                                                          Style="{StaticResource ModernComboBox}"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Volume Label" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource ModernTextBox}" 
                                                         Text="{Binding VolumeLabel, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Name shown in File Explorer"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- Dokan warning if not installed -->
                                        <Border Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1" 
                                                CornerRadius="4" Padding="12" Margin="0,0,0,12"
                                                Visibility="{Binding IsDokanInstalled, Converter={StaticResource InverseBoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="⚠️ Dokan Driver Required" FontWeight="SemiBold" 
                                                           Foreground="#C62828" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#B71C1C" FontSize="12">
                                                    Drive letter mounting requires the Dokan driver to be installed.
                                                    <LineBreak/>
                                                    Download from: https://github.com/dokan-dev/dokany/releases
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Navigation Pane option (shown only for ShellNamespace mode) -->
                                    <StackPanel Visibility="{Binding ShowNavigationPaneOption, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="Show in File Explorer navigation pane" 
                                                  IsChecked="{Binding ShowInNavigationPane}" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Preferences -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                    
                                    <CheckBox Content="Show notifications" Margin="0,0,0,8"
                                              IsChecked="{Binding ShowNotifications}"/>
                                    <CheckBox Content="Start with Windows" Margin="0,0,0,8"
                                              IsChecked="{Binding StartWithWindows}"/>
                                    <CheckBox Content="Start minimized to tray" Margin="0,0,0,8"
                                              IsChecked="{Binding StartMinimized}"/>
                                    <CheckBox Content="Show sync progress in tray" Margin="0,0,0,8"
                                              IsChecked="{Binding ShowSyncProgressInTray}"/>
                                    <CheckBox Content="Notify on conflicts" 
                                              IsChecked="{Binding ShowConflictNotifications}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Save Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset to Defaults" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ResetToDefaultsCommand}" Margin="0,0,8,0"/>
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelChangesCommand}" Margin="0,0,8,0"/>
                                <Button Content="Save Settings" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SaveSettingsCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Content="💾 Save &amp; Start Sync" Style="{StaticResource ModernButton}"
                                        Command="{Binding SaveAndStartCommand}"
                                        ToolTip="Save settings and start syncing to File Explorer"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
