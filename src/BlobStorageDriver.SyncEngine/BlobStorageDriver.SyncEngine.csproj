<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Target Windows 10 v1709+ for Cloud Filter API support -->
    <SupportedOSPlatformVersion>10.0.16299.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dokan is optional - only needed if using VirtualDriveManager instead of CloudFilterDriveManager -->
    <PackageReference Include="DokanNet" Version="2.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="LiteDB" Version="5.0.17" />
    <!-- WinRT APIs are included via the Windows 10 target framework (net8.0-windows10.0.19041.0) -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlobStorageDriver.Common\BlobStorageDriver.Common.csproj" />
    <ProjectReference Include="..\BlobStorageDriver.CloudProvider\BlobStorageDriver.CloudProvider.csproj" />
  </ItemGroup>

</Project>
