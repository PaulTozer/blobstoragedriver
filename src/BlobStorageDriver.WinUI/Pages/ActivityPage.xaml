<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BlobStorageDriver.WinUI.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Recent Activity" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        
        <ListView x:Name="ActivityList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" x:Name="ActivityIcon" Glyph="&#xE8B5;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FileName" Text="Filename" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ActivityType" Text="Activity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="2" x:Name="TimeStamp" Text="Just now" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
            <FontIcon Glyph="&#xE8B5;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="No recent activity" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Page>
