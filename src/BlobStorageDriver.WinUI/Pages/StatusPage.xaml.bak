<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BlobStorageDriver.WinUI.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="16">
            <!-- Status Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Status Icon -->
                    <Canvas Grid.Column="0" Width="64" Height="48" Margin="0,0,20,0">
                        <Ellipse Canvas.Left="8" Canvas.Top="36" Width="48" Height="10" Fill="#0078D4"/>
                        <Rectangle Canvas.Left="8" Canvas.Top="28" Width="48" Height="12" Fill="#0078D4"/>
                        <Ellipse Canvas.Left="8" Canvas.Top="22" Width="48" Height="10" Fill="#50AAE6"/>
                        <Rectangle Canvas.Left="8" Canvas.Top="14" Width="48" Height="12" Fill="#0078D4"/>
                        <Ellipse Canvas.Left="8" Canvas.Top="8" Width="48" Height="10" Fill="#50AAE6"/>
                        <Ellipse Canvas.Left="18" Canvas.Top="10" Width="28" Height="6" Fill="#80C8F0"/>
                    </Canvas>
                    
                    <!-- Status Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Ready" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LastSyncText" Text="Last synced: Never" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Pause Button -->
                    <Button Grid.Column="2" x:Name="PauseButton" Click="PauseButton_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PauseText" Text="Pause Sync"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Progress Card (visible during sync) -->
            <Border x:Name="ProgressCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock x:Name="CurrentFileText" Text="" 
                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="SyncProgressBar" Value="0" Maximum="100"/>
                </StackPanel>
            </Border>
            
            <!-- Stats Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Pending Card -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="PendingCountText" Text="0" FontSize="42" FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" Foreground="{StaticResource AzurePrimaryBrush}"/>
                        <TextBlock Text="Pending" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Conflicts Card -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="ConflictCountText" Text="0" FontSize="42" FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" Foreground="#F7630C"/>
                        <TextBlock Text="Conflicts" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Errors Card -->
                <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="ErrorCountText" Text="0" FontSize="42" FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" Foreground="#C42B1C"/>
                        <TextBlock Text="Errors" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Connection Info Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Connection Details" 
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Storage Account:" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StorageAccountText" Text="-" Margin="12,4,0,4"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Container:" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ContainerText" Text="-" Margin="12,4,0,4"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Local Folder:" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LocalFolderText" Text="-" 
                               TextTrimming="CharacterEllipsis" Margin="12,4,0,4"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
