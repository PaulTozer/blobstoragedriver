<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BlobStorageDriver.WinUI.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="16">
            <!-- Status Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Status Icon -->
                    <Border Grid.Column="0" Width="48" Height="48" Background="#0078D4" CornerRadius="8" 
                            Margin="0,0,16,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE753;" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Status Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Ready" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LastSyncText" Text="Last synced: Never" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                    
                    <!-- Pause Button -->
                    <Button Grid.Column="2" x:Name="PauseButton" Click="PauseButton_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PauseText" Text="Pause"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Progress Card -->
            <Border x:Name="ProgressCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ProgressText" Text="Syncing..." FontWeight="SemiBold"/>
                    <ProgressBar x:Name="SyncProgressBar" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="ProgressDetail" Text="0 of 0 files" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
            
            <!-- Stats Cards -->
            <Grid ColumnDefinitions="*,*,*">
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Pending" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="PendingCount" Text="0" FontSize="32" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Conflicts" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="ConflictCount" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="#D83B01"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Errors" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="ErrorCount" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="#A80000"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Connection Info -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Connection" FontWeight="SemiBold" FontSize="16"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Account:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AccountText" Text="Not configured"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Container:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ContainerText" Text="Not configured"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Local Path:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LocalPathText" Text="Not configured" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
