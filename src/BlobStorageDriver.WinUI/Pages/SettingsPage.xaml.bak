<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BlobStorageDriver.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="4" MaxWidth="700">
            <!-- Azure Connection Settings -->
            <TextBlock Text="Azure Connection" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <Grid Padding="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE753;" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Storage Account" FontWeight="SemiBold"/>
                            <TextBlock Text="Configure Azure Blob Storage connection" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="16" Padding="0,8">
                        <ComboBox x:Name="AuthTypeCombo" Header="Authentication Type" 
                                  HorizontalAlignment="Stretch" SelectionChanged="AuthType_SelectionChanged">
                            <ComboBoxItem Content="Connection String" Tag="ConnectionString"/>
                            <ComboBoxItem Content="Account Key" Tag="AccountKey"/>
                            <ComboBoxItem Content="SAS Token" Tag="SasToken"/>
                            <ComboBoxItem Content="Entra ID (Interactive)" Tag="EntraIdInteractive"/>
                            <ComboBoxItem Content="Entra ID (Default)" Tag="EntraIdDefault"/>
                        </ComboBox>
                        
                        <TextBox x:Name="ConnectionStringBox" Header="Connection String" 
                                 Visibility="Collapsed" PlaceholderText="DefaultEndpointsProtocol=https;..."/>
                        
                        <TextBox x:Name="AccountNameBox" Header="Account Name" 
                                 PlaceholderText="mystorageaccount"/>
                        
                        <TextBox x:Name="ContainerNameBox" Header="Container Name" 
                                 PlaceholderText="mycontainer"/>
                        
                        <PasswordBox x:Name="AccountKeyBox" Header="Account Key" 
                                     Visibility="Collapsed" PlaceholderText="Enter account key"/>
                        
                        <TextBox x:Name="SasTokenBox" Header="SAS Token" 
                                 Visibility="Collapsed" PlaceholderText="?sv=2021-06-08&ss=..."/>
                        
                        <TextBox x:Name="TenantIdBox" Header="Tenant ID (optional)" 
                                 Visibility="Collapsed" PlaceholderText="00000000-0000-0000-0000-000000000000"/>
                        
                        <TextBox x:Name="ClientIdBox" Header="Client ID (optional)" 
                                 Visibility="Collapsed" PlaceholderText="00000000-0000-0000-0000-000000000000"/>
                        
                        <Button Content="Test Connection" Click="TestConnection_Click" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Expander.Content>
            </Expander>
            
            <!-- Local Sync Settings -->
            <TextBlock Text="Sync Settings" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/>
            
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <Grid Padding="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Local Folder" FontWeight="SemiBold"/>
                            <TextBlock Text="Where synced files are stored locally" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="16" Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocalFolderBox" Grid.Column="0" Header="Sync Folder Path" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseFolder_Click" 
                                    VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                        </Grid>
                        
                        <NumberBox x:Name="SyncIntervalBox" Header="Sync Interval (minutes)" 
                                   Minimum="1" Maximum="1440" SpinButtonPlacementMode="Inline"/>
                        
                        <ToggleSwitch x:Name="RealTimeSyncToggle" Header="Real-time Sync"
                                      OnContent="Enabled" OffContent="Disabled"/>
                    </StackPanel>
                </Expander.Content>
            </Expander>
            
            <!-- Integration Settings -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Padding="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B8;" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Integration" FontWeight="SemiBold"/>
                            <TextBlock Text="Virtual drive and shell integration" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="16" Padding="0,8">
                        <ComboBox x:Name="IntegrationModeCombo" Header="Integration Mode" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Folder Sync Only" Tag="LocalFolder"/>
                            <ComboBoxItem Content="Virtual Drive (Dokan)" Tag="VirtualDrive"/>
                            <ComboBoxItem Content="Shell Namespace" Tag="ShellNamespace"/>
                        </ComboBox>
                        
                        <ComboBox x:Name="DriveLetterCombo" Header="Drive Letter" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="W:"/>
                            <ComboBoxItem Content="X:"/>
                            <ComboBoxItem Content="Y:"/>
                            <ComboBoxItem Content="Z:"/>
                        </ComboBox>
                        
                        <TextBox x:Name="VolumeLabelBox" Header="Volume Label" PlaceholderText="Azure Blob Storage"/>
                    </StackPanel>
                </Expander.Content>
            </Expander>
            
            <!-- Application Settings -->
            <TextBlock Text="Application" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/>
            
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Padding="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7F4;" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Startup &amp; Notifications" FontWeight="SemiBold"/>
                            <TextBlock Text="App behavior and notification preferences" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="12" Padding="0,8">
                        <ToggleSwitch x:Name="StartWithWindowsToggle" Header="Start with Windows"
                                      OnContent="Yes" OffContent="No"/>
                        <ToggleSwitch x:Name="StartMinimizedToggle" Header="Start Minimized"
                                      OnContent="Yes" OffContent="No"/>
                        <ToggleSwitch x:Name="ShowNotificationsToggle" Header="Show Notifications"
                                      OnContent="Yes" OffContent="No"/>
                    </StackPanel>
                </Expander.Content>
            </Expander>
            
            <!-- Save Button -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Grid.Column="1" Content="Reset" Click="Reset_Click" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Save Settings" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
