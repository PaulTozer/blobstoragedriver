<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="BlobStorageDriver.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlobStorageDriver.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- App accent color -->
            <Color x:Key="SystemAccentColor">#0078D4</Color>
            
            <!-- Azure brand colors -->
            <SolidColorBrush x:Key="AzurePrimaryBrush" Color="#0078D4"/>
            <SolidColorBrush x:Key="AzureSecondaryBrush" Color="#50AAE6"/>
            <SolidColorBrush x:Key="AzureHighlightBrush" Color="#80C8F0"/>
            
            <!-- Navigation item style -->
            <Style x:Key="NavItemStyle" TargetType="Button">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
