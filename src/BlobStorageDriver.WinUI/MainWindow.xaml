<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BlobStorageDriver.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlobStorageDriver.WinUI"
    Title="Blob Storage Driver">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar Area (for dragging) -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- App Icon -->
                <Canvas Grid.Column="0" Width="32" Height="24" Margin="12,0,8,0" VerticalAlignment="Center">
                    <!-- Stacked cylinders storage icon -->
                    <Ellipse Canvas.Left="2" Canvas.Top="17" Width="28" Height="6" Fill="#0078D4"/>
                    <Rectangle Canvas.Left="2" Canvas.Top="13" Width="28" Height="6" Fill="#0078D4"/>
                    <Ellipse Canvas.Left="2" Canvas.Top="9" Width="28" Height="6" Fill="#50AAE6"/>
                    <Rectangle Canvas.Left="2" Canvas.Top="5" Width="28" Height="6" Fill="#0078D4"/>
                    <Ellipse Canvas.Left="2" Canvas.Top="1" Width="28" Height="6" Fill="#50AAE6"/>
                    <Ellipse Canvas.Left="7" Canvas.Top="2" Width="18" Height="3" Fill="#80C8F0"/>
                </Canvas>
                
                <!-- Title -->
                <TextBlock Grid.Column="1" Text="Blob Storage Driver" 
                           VerticalAlignment="Center" 
                           Style="{StaticResource CaptionTextBlockStyle}"/>
            </Grid>
        </Border>
        
        <!-- Main Navigation -->
        <NavigationView 
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="280"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">
            
            <NavigationView.PaneHeader>
                <StackPanel Margin="8,8,8,16">
                    <Canvas Width="48" Height="36" HorizontalAlignment="Left" Margin="4,0,0,8">
                        <!-- Stacked cylinders storage icon - larger -->
                        <Ellipse Canvas.Left="4" Canvas.Top="26" Width="40" Height="9" Fill="#0078D4"/>
                        <Rectangle Canvas.Left="4" Canvas.Top="20" Width="40" Height="9" Fill="#0078D4"/>
                        <Ellipse Canvas.Left="4" Canvas.Top="14" Width="40" Height="9" Fill="#50AAE6"/>
                        <Rectangle Canvas.Left="4" Canvas.Top="8" Width="40" Height="9" Fill="#0078D4"/>
                        <Ellipse Canvas.Left="4" Canvas.Top="2" Width="40" Height="9" Fill="#50AAE6"/>
                        <Ellipse Canvas.Left="12" Canvas.Top="4" Width="24" Height="5" Fill="#80C8F0"/>
                    </Canvas>
                    <TextBlock Text="Blob Storage" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Driver" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Status" Tag="Status" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Conflicts" Tag="Conflicts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            
            <NavigationView.PaneFooter>
                <StackPanel Margin="12,8">
                    <Button HorizontalAlignment="Stretch" Click="OpenSyncFolder_Click" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xED25;" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Open Sync Folder"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" 
                            Click="SyncNow_Click" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE895;" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Sync Now"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>
            
            <!-- Content Frame -->
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
